# Copy to .env (make env does it). Never commit .env.

# Port the server listens on (also the published port in Docker).
PORT=3030

# The write key. Everyone is read-only until they enter it in the web UI (Unlock), and agents send it
# as PJPLANNER_API_KEY. Pick your own long random string.
WRITE_KEY=change-me

# Address agents use to reach the server in Docker (the container cannot see your LAN IP), e.g. http://192.168.1.20:3030
PUBLIC_URL=

# Optional Jira integration (Jira Data Center / Server, REST API v2). One shared bot account for the whole team.
# JIRA_URL is the base address of Jira, JIRA_TOKEN a Personal Access Token of the bot. Leave both empty to turn it off.
JIRA_URL=
JIRA_TOKEN=
